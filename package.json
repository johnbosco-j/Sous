{
  "name": "sous",
  "version": "1.0.0",
  "description": "Sous: a zero-waste kitchen agent for Alexa+. Self-hosted MCP server (spec 2025-11-25, Streamable HTTP) with MCP Apps views for Echo Show, plus an Alexa+ simulator driven by Amazon Bedrock.",
  "type": "module",
  "license": "MIT",
  "author": "John Bosco J",
  "repository": { "type": "git", "url": "https://github.com/johnbosco-j/sous" },
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "reset": "tsx src/domain/reset.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
