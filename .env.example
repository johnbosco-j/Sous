# Copy to .env (loaded automatically). Everything is optional: without AWS credentials Sous runs fully on
# its deterministic engine, and the simulator still works end to end.

PORT=8787

# ---- Amazon Bedrock (AWS Builder) ----
# Option A (easiest): a Bedrock API key from the Bedrock console -> API keys
# AWS_BEARER_TOKEN_BEDROCK=
# Option B: standard IAM credentials (or AWS_PROFILE=...)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# Any Converse-API model with tool use your account can invoke (inference profile ids work too)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_TIMEOUT_MS=8000
# auto = use Bedrock when credentials exist; off = always deterministic
SOUS_BEDROCK=auto

# Comma-separated Host allow-list; enables DNS-rebinding protection for /mcp when set
ALLOWED_HOSTS=
