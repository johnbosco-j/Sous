{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install",
  "outputDirectory": "web",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mcp", "destination": "/api/index" },
    { "source": "/healthz", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "includeFiles": "ui/**", "maxDuration": 30 }
  },
  "headers": [
    { "source": "/mcp", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
